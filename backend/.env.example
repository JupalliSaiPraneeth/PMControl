# OmniControl Backend Environment Configuration
PORT=4000
NODE_ENV=development
DASHBOARD_ORIGIN=http://localhost:5173

# Supabase Credentials (from your Supabase project settings -> API)
# Notice: SUPABASE_SERVICE_ROLE_KEY is server-only and NEVER exposed to frontend or Android
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# WebRTC STUN/TURN Server Configuration
# For local development, Google's public STUN server is used as default.
# For production NAT traversal, configure your coturn or Twilio/Xirsys TURN credentials.
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Rate Limiting & Security
PAIRING_CODE_TTL_SECONDS=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=10
