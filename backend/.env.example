# OmniControl Backend Environment Configuration
PORT=4000
NODE_ENV=development
DASHBOARD_ORIGIN=http://localhost:5173

# Supabase Credentials (from your Supabase project settings -> API)
# Notice: SUPABASE_SERVICE_ROLE_KEY is server-only and NEVER exposed to frontend or Android
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# WebRTC STUN/TURN Server Configuration
# Multi-STUN discovery (comma-separated list):
STUN_SERVER_URL=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Production TURN Relay (e.g., coturn, Twilio, Metered.ca, or Cloudflare Calls)
# Required for NAT traversal across different networks (e.g. Wi-Fi <-> 5G/Mobile Data)
TURN_SERVER_URL=turn:your-turn-server.com:3478?transport=udp,turn:your-turn-server.com:3478?transport=tcp,turns:your-turn-server.com:5349?transport=tcp
# Option A: Static TURN credentials
TURN_USERNAME=omnicontrol_user
TURN_CREDENTIAL=your_turn_password
# Option B: Ephemeral coturn HMAC-SHA1 secret (Recommended for production rotation)
TURN_SECRET=your_coturn_auth_secret

# Rate Limiting & Security
PAIRING_CODE_TTL_SECONDS=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=10
